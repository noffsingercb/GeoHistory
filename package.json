{
  "name": "geohistory",
  "version": "0.7.0",
  "description": "Open geo-located historical events dataset and deterministic timeline protocol.",
  "license": "MIT",
  "author": "Ben Noffsinger",
  "type": "module",
  "scripts": {
    "ingest": "tsx ingest.ts",
    "ingest:dump": "tsx ingest-dump.ts",
    "ingest:check": "tsx ingest-dump.ts --check",
    "migrate": "tsx migrate-v06.ts",
    "seed": "tsx seed.ts",
    "expand:participants": "tsx expand-participants.ts",
    "score": "tsx score.ts",
    "rescope:foundings": "tsx rescope-foundings.ts",
    "titles": "tsx display-titles.ts",
    "prune": "tsx prune.ts",
    "prune:series": "tsx prune-series.ts",
    "prune:media": "tsx prune-media.ts",
    "prune:dupes": "tsx prune-seed-dupes.ts",
    "post-ingest": "npm run seed && npm run prune:dupes && npm run prune:series -- --apply && npm run rescope:foundings && npm run score && npm run expand:participants && npm run score && npm run titles",
    "diag": "tsx diagnostics/v06-baseline.ts",
    "timeline": "tsx timeline.ts",
    "search": "tsx search.ts",
    "stats": "tsx stats.ts",
    "serve": "tsx server.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
